{
  "name": "@repo/convex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "_generated/api.js",
  "types": "_generated/api.d.ts",
  "exports": {
    "./_generated/api": {
      "types": "./_generated/api.d.ts",
      "default": "./_generated/api.js"
    },
    "./_generated/dataModel": {
      "types": "./_generated/dataModel.d.ts",
      "default": "./_generated/dataModel.js"
    },
    "./types": {
      "types": "./types.ts",
      "default": "./types.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "build": "tsc --noEmit",
    "deploy": "convex deploy",
    "type-check": "tsc --noEmit",
    "bundle-worker": "node ../../scripts/bundle-worker.js"
  },
  "dependencies": {
    "@clerk/backend": "^2.17.2",
    "@daytonaio/sdk": "^0.109.0",
    "@octokit/auth-app": "^8.1.1",
    "convex": "^1.27.0",
    "ms": "^2.1.3",
    "nanoid": "^5.1.6",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "@types/node": "^24.7.0",
    "typescript": "^5"
  }
}
