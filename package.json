{
  "name": "oracode",
  "version": "0.1.0",
  "description": "AI-powered coding assistant that creates branches, writes code, and opens pull requests—all from a chat interface",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "author": "Oracode Team",
  "homepage": "https://github.com/yourusername/oracode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/oracode.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/oracode/issues"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "claude",
    "convex",
    "daytona",
    "github",
    "nextjs",
    "typescript"
  ],
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.14"
    }
  }
}
